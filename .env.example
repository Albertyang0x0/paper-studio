OPENROUTER_API_KEY=
OPENROUTER_TEXT_MODEL=google/gemini-3.1-pro-preview
OPENROUTER_IMAGE_MODEL=google/gemini-3-pro-image
PAPER_REASONING_EFFORT=high
PORT=8787
# Optional: reduces public literature API rate-limit failures. Server only.
SEMANTIC_SCHOLAR_API_KEY=
# Optional: path to an already installed pdflatex; no automatic TeX installation.
PAPER_PDFLATEX=pdflatex
# Optional HTTP(S) proxy. Windows loopback system proxy is detected automatically.
PAPER_PROXY_URL=
PAPER_SYSTEM_PROXY=1
